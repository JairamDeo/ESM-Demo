PORT=5050
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/vitric-esm

# Comma-separated browser origins (only needed for cross-origin API calls)
CORS_ORIGIN=http://localhost:5173,http://192.168.31.34:5173,http://192.168.31.109:5173

# LAN: teammates open http://<your-wifi-ip>:5173 only.
# Frontend should use VITE_API_URL=/api (not :5050) so Vite proxies the API.
# If :5050 must be reached directly, run scripts/open-lan-firewall.ps1 as Admin.

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# MSG91 SMS
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_OTP_LOGIN=
MSG91_OTP_VAR=OTP
# Announcement broadcast flow (template vars: NAME, TITLE, MESSAGE by default)
MSG91_FLOW_ANNOUNCEMENT=
MSG91_ANNOUNCE_NAME_VAR=NAME
MSG91_ANNOUNCE_TITLE_VAR=TITLE
MSG91_ANNOUNCE_MSG_VAR=MESSAGE

# Cloudinary (required — separate vars in .env)
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder in Cloudinary (category icons → esm/category-master/)
CLOUDINARY_FOLDER=esm
# After setting keys, assign Upload role to the API key in Cloudinary Console → API Keys
# Root folder in Cloudinary (category icons → esm/category-master/)
CLOUDINARY_FOLDER=esm
