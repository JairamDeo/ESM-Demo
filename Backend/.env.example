# Server
PORT=5050
# 0.0.0.0 = listen on all interfaces so phones/PCs on the same Wi‑Fi can reach this API
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=

# JWT Secrets (use long random strings in production)
JWT_SECRET=vitric_esm_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=vitric_esm_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# OTP Config
# OTP_ENABLE=true  → send SMS via MSG91 | false → log OTP in server console only
OTP_ENABLE=false
OTP_BYPASS=true
OTP_BYPASS_CODE=1234

# MSG91 SMS (login OTP flow)
MSG91_AUTH_KEY=auth key from msg91
MSG91_SENDER_ID=sender id from msg91
MSG91_FLOW_OTP_LOGIN=login otp flow id
MSG91_OTP_VAR=OTP

MSG91_FLOW_ANNOUNCEMENT=<your announcement flow id from MSG91>
MSG91_ANNOUNCE_NAME_VAR=NAME
MSG91_ANNOUNCE_TITLE_VAR=TITLE
MSG91_ANNOUNCE_MSG_VAR=MESSAGE


# QR encode target (first URL). LAN IP for local phone scan; Vercel URL when live.
FRONTEND_URL=http://localhost:5174

# CORS — comma-separated frontend origins.
# Local: http://localhost:5174
# Phone on same Wi‑Fi: add http://<THIS-PC-LAN-IP>:5174  (e.g. http://192.168.1.10:5174)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cloudinary (file uploads — images saved as WebP, PDFs as-is)
CLOUDINARY_CLOUD_NAME=dhqexh18e
CLOUDINARY_API_KEY=537749158839236
CLOUDINARY_API_SECRET=efCySluBujjmQPxSTAteWQbdH98
CLOUDINARY_FOLDER=esm
# Set false to force local /uploads only
USE_CLOUDINARY=true

# Rate Limiting — set true to enable (blocks after RATE_LIMIT_MAX requests per window)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=BBuNb3XMa-ld398XgqjbZGfjbgHrMkgUJB6BzU-wJIT4Ga5YN-bggoAzFxCWOi6BMzLxlZShtPZvcWp_ei5K6cY
VAPID_PRIVATE_KEY=SV-QAtn3PYygHp_IiMhtsRTX999S8xBPUpiJdOWgAn8
VAPID_SUBJECT=mailto:support@vitric.in